{
  "workflow_id": "daily_report",
  "name": "每日运营报告生成",
  "description": "自动生成每日电商运营总结：热点汇总+平台政策+竞品动态+数据洞察+行动建议",
  "version": "1.0.0",
  "entry_node": "start",
  "nodes": [
    {"node_id": "start", "type": "Start", "name": "日报生成触发", "position": {"x": 250, "y": 50}, "input_params": [{"name": "date", "type": "string", "description": "报告日期", "required": false, "default": "今天"}, {"name": "focus_platforms", "type": "array", "description": "关注平台", "required": false, "default": ["抖音","淘宝","拼多多","京东","小红书"]}], "output_params": [{"name": "date", "type": "string"}, {"name": "focus_platforms", "type": "array"}]},
    {"node_id": "news_collect", "type": "HTTP", "name": "全天热点采集", "position": {"x": 120, "y": 170}, "plugin": "web_search", "search_query": "电商 今日热点 平台政策 新规 2025 2026", "max_results": 20,
      "input_params": [{"name": "focus_platforms", "type": "array", "source": "start.focus_platforms"}], "output_params": [{"name": "hot_news", "type": "array"}]},
    {"node_id": "trend_collect", "type": "HTTP", "name": "趋势数据采集", "position": {"x": 380, "y": 170}, "plugin": "web_search", "search_query": "电商 热销商品 爆款 趋势 销量排行", "max_results": 10,
      "output_params": [{"name": "trend_data", "type": "array"}]},
    {"node_id": "report_generator", "type": "LLM", "name": "日报生成引擎", "position": {"x": 250, "y": 330}, "model": "doubao-pro-128k", "temperature": 0.4, "max_tokens": 8000,
      "prompt_template": "你是电商运营日报编辑。基于以下数据生成每日运营报告。\n\n日期：{{date}}\n关注平台：{{focus_platforms}}\n热点新闻：{{news_collect.hot_news}}\n趋势数据：{{trend_collect.trend_data}}\n\n输出格式：\n# 📊 灵犀每日运营报告\n**日期：** {{date}}\n\n## 🔥 今日热点\n（3-5条最重要的电商新闻，每条附一句话点评）\n\n## 📋 平台政策速递\n（各平台新政策、规则变化、大促信息）\n\n## 📈 品类趋势\n（今日热销品类、关键词趋势、价格带变化）\n\n## 🎯 爆款拆解\n（分析1-2个今日爆款案例）\n\n## ⚠️ 风险提示\n（需关注的负面事件、平台处罚案例）\n\n## 💡 今日行动建议\n（3-5条可执行的操作建议）",
      "input_params": [{"name": "date", "type": "string", "source": "start.date"}, {"name": "focus_platforms", "type": "array", "source": "start.focus_platforms"}, {"name": "hot_news", "type": "array", "source": "news_collect.hot_news"}, {"name": "trend_data", "type": "array", "source": "trend_collect.trend_data"}],
      "output_params": [{"name": "daily_report", "type": "string"}]},
    {"node_id": "end", "type": "End", "name": "输出日报", "position": {"x": 250, "y": 490}, "output_params": [{"name": "final_report", "type": "string", "source": "report_generator.daily_report"}]}
  ],
  "edges": [{"source": "start", "target": "news_collect"}, {"source": "start", "target": "trend_collect"}, {"source": "news_collect", "target": "report_generator"}, {"source": "trend_collect", "target": "report_generator"}, {"source": "report_generator", "target": "end"}]
}
